# Local MongoDB; use MongoDB Atlas on Vercel (localhost is not reachable there).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=relay
# Generate with: openssl rand -hex 32
SESSION_SECRET=
TEAM_ACCESS_CODE=
# Server only. Needs publish, subscribe and presence capabilities on relay:*.
ABLY_API_KEY=
GITHUB_REPO=HarshitKumar9030/commit-tracker
# Required for private repos, recommended to avoid GitHub anonymous rate limits.
GITHUB_TOKEN=
# Generate independently; set the same secret in your GitHub webhook.
GITHUB_WEBHOOK_SECRET=

# Optional: local watcher identity for a newly created team group.
# WATCH_TEAM_ID=
# WATCH_MEMBER_ID=
# WATCH_TEAM_CODE=
