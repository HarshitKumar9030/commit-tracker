{
  "name": "relay-commit-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:start": "node scripts/mongodb.mjs",
    "watch:repo": "node --env-file=.env.local scripts/watch-repo.mjs",
    "test:live": "node --env-file=.env.local scripts/check-live.mjs",
    "format": "prettier --write app components lib scripts tests *.ts *.json *.md",
    "test:teams": "node --env-file=.env.local scripts/check-teams.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.102",
    "ably": "2.29.0",
    "ai": "7.0.148",
    "framer-motion": "14.5.0",
    "gsap": "3.15.0",
    "lucide-react": "1.60.0",
    "mongodb": "7.7.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
